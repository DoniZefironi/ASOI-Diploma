        "body": {
          "mode": "raw",
          "raw": "{\n  \"innovationScore\": 90,\n  \"functionalityScore\": 95,\n  \"presentationScore\": 92,\n  \"teamworkScore\": 90,\n  \"feedback\": \"Отличная архитектура системы, хорошо задокументированный код. Рекомендую добавить обработку ошибок при потере соединения с датчиком.\"\n}"
        }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
        "pm.test('Grade record created', () => {",
        "  pm.expect(pm.response.json()).to.be.an('object');",
        "});"
      ]}}]
