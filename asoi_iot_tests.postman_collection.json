    {
      "name": "4.1 — Создание IoT-комнаты → 201",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base}}/rooms",
          "host": ["{{base}}"],
          "path": ["rooms"]
        },
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{studentToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"IoT Lab Alpha\",\n  \"type\": \"iot\",\n  \"isPublic\": true,\n  \"description\": \"Совместная работа над IoT-сенсорами\"\n}"
        }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
        "pm.test('Has id and inviteCode', () => {",
        "  const j = pm.response.json();",
        "  pm.expect(j).to.have.property('id');",
        "  pm.expect(j).to.have.property('inviteCode');",
        "  pm.collectionVariables.set('roomId', String(j.id));",
        "  pm.collectionVariables.set('inviteCode', j.inviteCode);",
        "});",
        "pm.test('isPublic = true', () => {",
        "  pm.expect(pm.response.json().isPublic).to.equal(true);",
        "});"
      ]}}]
    },

    {
      "name": "4.2 — Вступление по invite-коду → 201",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base}}/rooms/invite/{{inviteCode}}/join",
          "host": ["{{base}}"],
          "path": ["rooms", "invite", "{{inviteCode}}", "join"]
        },
        "header": [
          { "key": "Authorization", "value": "Bearer {{viewerToken}}" }
        ]
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
        "pm.test('Member record created', () => {",
        "  pm.expect(pm.response.json()).to.be.an('object');",
        "});"
      ]}}]
    },

    {
      "name": "4.3 — Повторное вступление → 409 Conflict",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base}}/rooms/invite/{{inviteCode}}/join",
          "host": ["{{base}}"],
          "path": ["rooms", "invite", "{{inviteCode}}", "join"]
        },
        "header": [
          { "key": "Authorization", "value": "Bearer {{viewerToken}}" }
        ]
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 409 Conflict (UQ_rm_room_user)', () => pm.response.to.have.status(409));"
      ]}}]
    },

    {
      "name": "4.4 — Обновление состояния комнаты (editor) → 200",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base}}/rooms/{{roomId}}/state",
          "host": ["{{base}}"],
          "path": ["rooms", "{{roomId}}", "state"]
        },
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{editorToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"state\": {\n    \"nodes\": [\n      {\n        \"id\": \"n1\",\n        \"type\": \"sensor\",\n        \"x\": 100,\n        \"y\": 150,\n        \"config\": { \"unit\": \"°C\", \"minValue\": -10, \"maxValue\": 50 }\n      },\n      {\n        \"id\": \"n2\",\n        \"type\": \"display\",\n        \"x\": 300,\n        \"y\": 150,\n        \"config\": {}\n      }\n    ],\n    \"wires\": [\n      { \"sourceId\": \"n1\", \"sourcePort\": \"out\", \"targetId\": \"n2\", \"targetPort\": \"in\" }\n    ],\n    \"meta\": { \"scale\": 1.0, \"offsetX\": 0, \"offsetY\": 0 }\n  }\n}"
        }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
        "pm.test('State field updated', () => {",
        "  pm.expect(pm.response.json()).to.be.an('object');",
        "});"
      ]}}]
    },

    {
      "name": "4.5 — Обновление состояния комнаты (viewer) → 403",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base}}/rooms/{{roomId}}/state",
          "host": ["{{base}}"],
          "path": ["rooms", "{{roomId}}", "state"]
        },
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{viewerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"state\": {\n    \"nodes\": [],\n    \"wires\": [],\n    \"meta\": { \"scale\": 1.0, \"offsetX\": 0, \"offsetY\": 0 }\n  }\n}"
        }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 403 Forbidden', () => pm.response.to.have.status(403));"
      ]}}]
    },

    {
      "name": "4.6 — Регистрация команды на хакатон → 201",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base}}/hackathons/teams",
          "host": ["{{base}}"],
          "path": ["hackathons", "teams"]
        },
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{studentToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hackathonId\": {{hackathonId}},\n  \"name\": \"Team IoT Masters\",\n  \"memberIds\": [2, 3],\n  \"projectName\": \"IoT Monitoring System\",\n  \"projectDescription\": \"Система мониторинга микроклимата на базе ESP32\"\n}"
        }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
        "pm.test('Has team id', () => {",
        "  const j = pm.response.json();",
        "  pm.expect(j).to.have.property('id');",
        "  pm.collectionVariables.set('teamId', String(j.id));",
        "});"
      ]}}]
    },

    {
