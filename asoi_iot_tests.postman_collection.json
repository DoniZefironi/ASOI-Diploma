    {
      "name": "4.13 — Просмотр стажировки с фиксацией аналитики → 200",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base}}/internships/{{internshipId}}",
          "host": ["{{base}}"],
          "path": ["internships", "{{internshipId}}"]
        },
        "header": [
          { "key": "Authorization", "value": "Bearer {{studentToken}}" }
        ]
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Has internship object with id and title', () => {",
        "  const j = pm.response.json();",
        "  pm.expect(j).to.have.property('id');",
        "  pm.expect(j).to.have.property('title');",
        "});"
      ]}}]
    },

    {
      "name": "4.14 — Создание элемента расписания (ментор) → 201",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base}}/schedule",
          "host": ["{{base}}"],
          "path": ["schedule"]
        },
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{mentorToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Лекция: Протоколы IoT — MQTT и CoAP\",\n  \"description\": \"Разбор протоколов IoT: MQTT и CoAP — особенности, сравнение, применение в реальных системах\",\n  \"type\": \"lecture\",\n  \"startTime\": \"2025-09-15T10:00:00.000Z\",\n  \"endTime\": \"2025-09-15T11:30:00.000Z\",\n  \"location\": \"Ауд. 301\"\n}"
        }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
        "pm.test('type = lecture', () => {",
        "  const j = pm.response.json();",
        "  pm.expect(j).to.have.property('id');",
        "  pm.expect(j.type).to.equal('lecture');",
        "});"
      ]}}]
    },

    {
      "name": "4.15 — Фильтрация расписания по дате → 200 + только 15.09",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base}}/schedule?startDate=2025-09-15T00:00:00.000Z&endDate=2025-09-15T23:59:59.999Z",
          "host": ["{{base}}"],
          "path": ["schedule"],
          "query": [
            { "key": "startDate", "value": "2025-09-15T00:00:00.000Z" },
            { "key": "endDate",   "value": "2025-09-15T23:59:59.999Z" }
          ]
        },
        "header": [
          { "key": "Authorization", "value": "Bearer {{studentToken}}" }
        ]
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
        "pm.test('Returns array', () => {",
        "  pm.expect(pm.response.json()).to.be.an('array');",
        "});",
        "pm.test('All items on 2025-09-15', () => {",
        "  pm.response.json().forEach(item => {",
        "    const d = new Date(item.startTime);",
        "    pm.expect(d.toISOString().startsWith('2025-09-15')).to.be.true;",
        "  });",
        "});"
      ]}}]
    }

  ]
