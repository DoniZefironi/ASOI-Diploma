    {
      "name": "4.11 — Подача заявки на стажировку → 201",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base}}/internships/{{internshipId}}/apply",
          "host": ["{{base}}"],
          "path": ["internships", "{{internshipId}}", "apply"]
        },
        "header": [
