          "path": ["auth", "login"]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"viewer.user@example.com\",\n  \"password\": \"Viewer1234!\"\n}"
        }
