        "body": {
          "mode": "raw",
          "raw": "{\n  \"comment\": \"Уважаемые коллеги, прошу рассмотреть мою кандидатуру на позицию IoT-разработчика. Имею опыт работы с ESP32 и протоколом MQTT в рамках учебных проектов.\"\n}"
        }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
        "pm.test('Has status pending', () => {",
        "  pm.expect(pm.response.json()).to.have.property('status');",
        "});"
      ]}}]
    },

