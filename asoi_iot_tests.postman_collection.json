          "raw": "{\n  \"teamId\": {{teamId}},\n  \"sourceCodeUrl\": \"https://github.com/team-iot/final-project\",\n  \"submissionNote\": \"Полная реализация IoT-системы мониторинга микроклимата с веб-интерфейсом\",\n  \"documentationUrl\": \"https://github.com/team-iot/final-project/wiki\"\n}"
        }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
