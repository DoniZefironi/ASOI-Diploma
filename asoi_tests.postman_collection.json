          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin1234!\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "if (j.access_token) {",
            "  pm.collectionVariables.set('adminToken', j.access_token);",
            "  console.log('adminToken saved');",
            "}"
          ]
        }
      }]
    },

