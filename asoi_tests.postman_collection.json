        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
            "pm.test('Has result object', () => {",
            "  pm.expect(pm.response.json()).to.be.an('object');",
            "});"
          ]
        }
      }]
    },

    {
      "name": "4.6 — Результаты анализа (трейты + топ-5 специальностей) → 200",
      "request": {
        "method": "GET",
        "url": { "raw": "{{base}}/professional-orientation/expert-analysis", "host": ["{{base}}"], "path": ["professional-orientation","expert-analysis"] },
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Has topCareers array', () => {",
            "  const j = pm.response.json();",
            "  pm.expect(j).to.have.property('topCareers');",
            "  pm.expect(j.topCareers).to.be.an('array');",
            "});",
            "pm.test('Has hollandType and personalityInsight', () => {",
            "  const j = pm.response.json();",
            "  pm.expect(j).to.have.property('hollandType');",
            "  pm.expect(j).to.have.property('personalityInsight');",
            "});"
          ]
        }
      }]
    },

    {
      "name": "4.7 — Генерация дорожной карты (Gemini / fallback) → 2xx",
      "request": {
        "method": "POST",
        "url": { "raw": "{{base}}/professional-orientation/roadmap", "host": ["{{base}}"], "path": ["professional-orientation","roadmap"] },
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"careerId\": \"backend_developer\",\n  \"careerTitle\": \"Backend-разработчик\",\n  \"traitScores\": {\n    \"analytical\": 8.5,\n    \"technical\": 9.0,\n    \"creative\": 5.5,\n    \"communicative\": 4.0,\n    \"leadership\": 3.5\n  },\n  \"firedRuleDescriptions\": [\n    \"Высокий аналитический потенциал\",\n    \"Склонность к системному мышлению\",\n    \"Предпочтение точных задач\"\n  ],\n  \"confidence\": 87\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Status 2xx (Gemini или fallback)', () => {",
            "  pm.expect(pm.response.code).to.be.within(200, 299);",
            "});",
            "pm.test('Has phases array with 4-5 phases', () => {",
            "  const j = pm.response.json();",
            "  pm.expect(j).to.have.property('phases');",
            "  pm.expect(j.phases.length).to.be.within(4, 5);",
            "});",
            "pm.test('Has totalDuration', () => {",
            "  pm.expect(pm.response.json()).to.have.property('totalDuration');",
            "});"
          ]
        }
      }]
    },

    {
      "name": "4.8 — История тестирований текущего пользователя → 200",
      "request": {
        "method": "GET",
        "url": { "raw": "{{base}}/professional-orientation", "host": ["{{base}}"], "path": ["professional-orientation"] },
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Has testResult field', () => {",
            "  const j = pm.response.json();",
            "  pm.expect(j).to.have.property('testResult');",
            "});",
            "pm.test('История другого пользователя недоступна без его токена', () => {",
            "  pm.expect(pm.response.code).to.not.equal(403);",
            "});"
          ]
        }
      }]
    },

    {
