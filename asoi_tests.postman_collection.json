    },

    {
      "name": "4.10 — Запуск кода в компиляторе → 200 + результат",
      "request": {
        "method": "POST",
        "url": { "raw": "{{base}}/compiler/execute", "host": ["{{base}}"], "path": ["compiler","execute"] },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"n = int(input())\\nprint(n * n)\",\n  \"language\": \"python\",\n  \"stdin\": \"7\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Output contains 49', () => {",
            "  const j = pm.response.json();",
            "  const out = j.output || j.result || j.stdout || '';",
            "  pm.expect(out).to.include('49');",
            "});"
          ]
        }
      }]
    },

    {
      "name": "4.10 — Компилятор: превышение лимита времени → без 500",
      "request": {
        "method": "POST",
        "url": { "raw": "{{base}}/compiler/execute", "host": ["{{base}}"], "path": ["compiler","execute"] },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"import time\\ntime.sleep(10)\\nprint('done')\",\n  \"language\": \"python\",\n  \"stdin\": \"\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('No 500 server error', () => pm.expect(pm.response.code).to.not.equal(500));",
            "pm.test('Response contains time_limit marker', () => {",
            "  const text = pm.response.text();",
            "  pm.expect(text).to.match(/time_limit|timeout|TLE|exceeded/i);",
            "});"
          ]
        }
      }]
    },

    {
      "name": "4.11 — Сдача задания через компилятор → 201",
