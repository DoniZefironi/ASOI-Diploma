@startuml
title Диаграмма последовательности: Проверка аутентификации

actor Пользователь as User
participant "ProtectedRoute\n(Next.js)" as PR
participant "AuthStore\n(Zustand)" as AS
participant "API Client\n(axios)" as API
participant "JwtAuthGuard\n(NestJS)" as JG

User -> PR: переход на защищённую страницу
PR -> AS: getToken() из localStorage

alt Токен отсутствует
  AS --> PR: null
  PR -> User: redirect('/auth')
else Токен присутствует
  AS --> PR: accessToken
  PR -> PR: декодировать payload
  PR -> PR: проверить соответствие роли маршруту

  alt Роль не соответствует маршруту
    PR -> User: redirect('/')
  else Роль соответствует
    PR -> API: GET /auth/me\nAuthorization: Bearer <token>
    API -> JG: canActivate(context)
    JG -> JG: jwt.verify(token, secret)

    alt Токен истёк или невалиден
      JG --> API: 401 Unauthorized
      API --> PR: ошибка 401
      PR -> AS: clearToken()
      PR -> User: redirect('/auth')
    else Токен валиден
      JG --> API: { userId, roles }
      API --> PR: 200 { user }
      PR -> AS: setUser(user)
      PR -> User: отрисовать защищённую страницу
    end
  end
end

@enduml
