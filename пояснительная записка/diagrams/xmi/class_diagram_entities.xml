      <memberEnd xmi:idref="ae_fp_src"/>
      <memberEnd xmi:idref="ae_fp_tgt"/>
      <ownedEnd xmi:id="ae_fp_src" type="cls_forum_topic" aggregation="composite" lower="1" upper="1"/>
      <ownedEnd xmi:id="ae_fp_tgt" type="cls_forum_post" lower="0" upper="*"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_cg_sched">
      <memberEnd xmi:idref="ae_cs_src"/>
