<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1"
         xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML">
  <uml:Model xmi:id="model_ent" name="Backend Entities and Services">

    <!-- ===== AUTH ===== -->
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_auth" name="auth">
      <packagedElement xmi:type="uml:Class" xmi:id="cls_auth_svc" name="AuthService">
        <ownedAttribute xmi:id="a_as1" name="jwtService" visibility="private"/>
        <ownedAttribute xmi:id="a_as2" name="usersService" visibility="private"/>
        <ownedOperation xmi:id="op_as1" name="login" visibility="public"/>
        <ownedOperation xmi:id="op_as2" name="register" visibility="public"/>
        <ownedOperation xmi:id="op_as3" name="validateUser" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_jwt_guard2" name="JwtAuthGuard">
        <ownedOperation xmi:id="op_jg1" name="canActivate" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_roles_guard2" name="RolesGuard">
        <ownedOperation xmi:id="op_rg1" name="canActivate" visibility="public"/>
      </packagedElement>
    </packagedElement>

    <!-- ===== USERS ===== -->
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_users" name="users">
      <packagedElement xmi:type="uml:Class" xmi:id="cls_user" name="User">
        <ownedAttribute xmi:id="a_u1" name="id" visibility="public"/>
        <ownedAttribute xmi:id="a_u2" name="email" visibility="public"/>
        <ownedAttribute xmi:id="a_u3" name="password" visibility="public"/>
        <ownedAttribute xmi:id="a_u4" name="firstName" visibility="public"/>
        <ownedAttribute xmi:id="a_u5" name="lastName" visibility="public"/>
        <ownedAttribute xmi:id="a_u6" name="isActive" visibility="public"/>
        <ownedAttribute xmi:id="a_u7" name="createdAt" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_user_role" name="UserRole">
        <ownedAttribute xmi:id="a_ur1" name="id" visibility="public"/>
        <ownedAttribute xmi:id="a_ur2" name="userId" visibility="public"/>
        <ownedAttribute xmi:id="a_ur3" name="role" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Enumeration" xmi:id="enum_role" name="UserRoleEnum">
        <ownedLiteral xmi:id="lit_admin" name="ADMIN"/>
        <ownedLiteral xmi:id="lit_reg" name="REGISTERED_USER"/>
        <ownedLiteral xmi:id="lit_stu" name="STUDENT_ELECTRONICS"/>
        <ownedLiteral xmi:id="lit_men" name="MENTOR_ELECTRONICS"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_users_svc" name="UsersService">
        <ownedOperation xmi:id="op_us1" name="findAll" visibility="public"/>
        <ownedOperation xmi:id="op_us2" name="findOne" visibility="public"/>
        <ownedOperation xmi:id="op_us3" name="getProfile" visibility="public"/>
        <ownedOperation xmi:id="op_us4" name="updateUserRoles" visibility="public"/>
      </packagedElement>
    </packagedElement>

    <!-- ===== COURSES ===== -->
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_courses" name="courses">
      <packagedElement xmi:type="uml:Class" xmi:id="cls_course" name="Course">
        <ownedAttribute xmi:id="a_c1" name="id" visibility="public"/>
        <ownedAttribute xmi:id="a_c2" name="name" visibility="public"/>
        <ownedAttribute xmi:id="a_c3" name="type" visibility="public"/>
        <ownedAttribute xmi:id="a_c4" name="description" visibility="public"/>
        <ownedAttribute xmi:id="a_c5" name="isActive" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_course_group" name="CourseGroup">
        <ownedAttribute xmi:id="a_cg1" name="id" visibility="public"/>
        <ownedAttribute xmi:id="a_cg2" name="name" visibility="public"/>
        <ownedAttribute xmi:id="a_cg3" name="year" visibility="public"/>
        <ownedAttribute xmi:id="a_cg4" name="semester" visibility="public"/>
        <ownedAttribute xmi:id="a_cg5" name="maxStudents" visibility="public"/>
        <ownedAttribute xmi:id="a_cg6" name="courseId" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_course_reg" name="CourseRegistration">
        <ownedAttribute xmi:id="a_cr1" name="id" visibility="public"/>
        <ownedAttribute xmi:id="a_cr2" name="userId" visibility="public"/>
        <ownedAttribute xmi:id="a_cr3" name="courseGroupId" visibility="public"/>
        <ownedAttribute xmi:id="a_cr4" name="status" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_courses_svc" name="CoursesService">
        <ownedOperation xmi:id="op_cs1" name="findAll" visibility="public"/>
        <ownedOperation xmi:id="op_cs2" name="findOne" visibility="public"/>
        <ownedOperation xmi:id="op_cs3" name="create" visibility="public"/>
        <ownedOperation xmi:id="op_cs4" name="update" visibility="public"/>
        <ownedOperation xmi:id="op_cs5" name="remove" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_cg_svc" name="CourseGroupsService">
        <ownedOperation xmi:id="op_cgs1" name="findAll" visibility="public"/>
        <ownedOperation xmi:id="op_cgs2" name="registerToCourse" visibility="public"/>
        <ownedOperation xmi:id="op_cgs3" name="approveRegistration" visibility="public"/>
      </packagedElement>
    </packagedElement>

    <!-- ===== ASSIGNMENTS ===== -->
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_assign" name="assignments">
      <packagedElement xmi:type="uml:Class" xmi:id="cls_assign" name="Assignment">
        <ownedAttribute xmi:id="a_a1" name="id" visibility="public"/>
        <ownedAttribute xmi:id="a_a2" name="title" visibility="public"/>
        <ownedAttribute xmi:id="a_a3" name="type" visibility="public"/>
        <ownedAttribute xmi:id="a_a4" name="maxScore" visibility="public"/>
        <ownedAttribute xmi:id="a_a5" name="startDate" visibility="public"/>
        <ownedAttribute xmi:id="a_a6" name="deadline" visibility="public"/>
        <ownedAttribute xmi:id="a_a7" name="courseGroupId" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_submission" name="AssignmentSubmission">
        <ownedAttribute xmi:id="a_sb1" name="id" visibility="public"/>
        <ownedAttribute xmi:id="a_sb2" name="content" visibility="public"/>
        <ownedAttribute xmi:id="a_sb3" name="status" visibility="public"/>
        <ownedAttribute xmi:id="a_sb4" name="finalScore" visibility="public"/>
        <ownedAttribute xmi:id="a_sb5" name="userId" visibility="public"/>
        <ownedAttribute xmi:id="a_sb6" name="assignmentId" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_peer_review" name="PeerReview">
        <ownedAttribute xmi:id="a_pr1" name="id" visibility="public"/>
        <ownedAttribute xmi:id="a_pr2" name="reviewerId" visibility="public"/>
        <ownedAttribute xmi:id="a_pr3" name="submissionId" visibility="public"/>
        <ownedAttribute xmi:id="a_pr4" name="score" visibility="public"/>
        <ownedAttribute xmi:id="a_pr5" name="feedback" visibility="public"/>
        <ownedAttribute xmi:id="a_pr6" name="isCompleted" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Enumeration" xmi:id="enum_assign_type" name="AssignmentType">
        <ownedLiteral xmi:id="lit_practice" name="PRACTICE"/>
        <ownedLiteral xmi:id="lit_test" name="TEST"/>
        <ownedLiteral xmi:id="lit_review" name="PRACTICE_REVIEW"/>
        <ownedLiteral xmi:id="lit_hack" name="HACKATHON"/>
        <ownedLiteral xmi:id="lit_olympiad" name="OLYMPIAD"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_assign_svc" name="AssignmentsService">
        <ownedOperation xmi:id="op_asvc1" name="createAssignment" visibility="public"/>
        <ownedOperation xmi:id="op_asvc2" name="createSubmission" visibility="public"/>
        <ownedOperation xmi:id="op_asvc3" name="createPeerReview" visibility="public"/>
        <ownedOperation xmi:id="op_asvc4" name="calculateFinalGrade" visibility="public"/>
      </packagedElement>
    </packagedElement>

    <!-- ===== MATERIALS ===== -->
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_mat" name="materials">
      <packagedElement xmi:type="uml:Class" xmi:id="cls_material" name="CourseMaterial">
        <ownedAttribute xmi:id="a_m1" name="id" visibility="public"/>
        <ownedAttribute xmi:id="a_m2" name="title" visibility="public"/>
        <ownedAttribute xmi:id="a_m3" name="type" visibility="public"/>
        <ownedAttribute xmi:id="a_m4" name="fileUrl" visibility="public"/>
        <ownedAttribute xmi:id="a_m5" name="isPublic" visibility="public"/>
        <ownedAttribute xmi:id="a_m6" name="courseId" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_mat_svc" name="MaterialsService">
        <ownedOperation xmi:id="op_ms1" name="findAll" visibility="public"/>
        <ownedOperation xmi:id="op_ms2" name="getPublicMaterials" visibility="public"/>
        <ownedOperation xmi:id="op_ms3" name="create" visibility="public"/>
      </packagedElement>
    </packagedElement>

    <!-- ===== FORUM ===== -->
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_forum" name="forum">
      <packagedElement xmi:type="uml:Class" xmi:id="cls_forum_sec" name="ForumSection">
        <ownedAttribute xmi:id="a_fsec1" name="id" visibility="public"/>
        <ownedAttribute xmi:id="a_fsec2" name="title" visibility="public"/>
        <ownedAttribute xmi:id="a_fsec3" name="courseId" visibility="public"/>
        <ownedAttribute xmi:id="a_fsec4" name="orderIndex" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_forum_topic" name="ForumTopic">
        <ownedAttribute xmi:id="a_ftop1" name="id" visibility="public"/>
        <ownedAttribute xmi:id="a_ftop2" name="title" visibility="public"/>
        <ownedAttribute xmi:id="a_ftop3" name="sectionId" visibility="public"/>
        <ownedAttribute xmi:id="a_ftop4" name="authorId" visibility="public"/>
        <ownedAttribute xmi:id="a_ftop5" name="isPinned" visibility="public"/>
        <ownedAttribute xmi:id="a_ftop6" name="isClosed" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_forum_post" name="ForumPost">
        <ownedAttribute xmi:id="a_fpost1" name="id" visibility="public"/>
