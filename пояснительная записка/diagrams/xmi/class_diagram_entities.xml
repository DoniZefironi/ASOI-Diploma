    <packagedElement xmi:type="uml:Association" xmi:id="assoc_assign_sub">
      <memberEnd xmi:idref="ae_as_src"/>
      <memberEnd xmi:idref="ae_as_tgt"/>
      <ownedEnd xmi:id="ae_as_src" type="cls_assign" aggregation="composite" lower="1" upper="1"/>
      <ownedEnd xmi:id="ae_as_tgt" type="cls_submission" lower="0" upper="*"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_sub_pr">
      <memberEnd xmi:idref="ae_sp_src"/>
      <memberEnd xmi:idref="ae_sp_tgt"/>
      <ownedEnd xmi:id="ae_sp_src" type="cls_submission" aggregation="composite" lower="1" upper="1"/>
      <ownedEnd xmi:id="ae_sp_tgt" type="cls_peer_review" lower="0" upper="*"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_course_mat">
      <memberEnd xmi:idref="ae_cm_src"/>
      <memberEnd xmi:idref="ae_cm_tgt"/>
      <ownedEnd xmi:id="ae_cm_src" type="cls_course" aggregation="composite" lower="1" upper="1"/>
      <ownedEnd xmi:id="ae_cm_tgt" type="cls_material" lower="0" upper="*"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_course_forum">
      <memberEnd xmi:idref="ae_cf_src"/>
      <memberEnd xmi:idref="ae_cf_tgt"/>
      <ownedEnd xmi:id="ae_cf_src" type="cls_course" aggregation="composite" lower="1" upper="1"/>
      <ownedEnd xmi:id="ae_cf_tgt" type="cls_forum_sec" lower="0" upper="*"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_fsec_ftop">
      <memberEnd xmi:idref="ae_ft_src"/>
      <memberEnd xmi:idref="ae_ft_tgt"/>
      <ownedEnd xmi:id="ae_ft_src" type="cls_forum_sec" aggregation="composite" lower="1" upper="1"/>
      <ownedEnd xmi:id="ae_ft_tgt" type="cls_forum_topic" lower="0" upper="*"/>
    </packagedElement>
