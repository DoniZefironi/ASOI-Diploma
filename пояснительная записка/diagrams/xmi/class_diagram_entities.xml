        <ownedAttribute xmi:id="a_fpost4" name="authorId" visibility="public"/>
        <ownedAttribute xmi:id="a_fpost5" name="isEdited" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_forum_svc" name="ForumService">
        <ownedOperation xmi:id="op_fsvc1" name="getSectionsByCourse" visibility="public"/>
        <ownedOperation xmi:id="op_fsvc2" name="createTopic" visibility="public"/>
        <ownedOperation xmi:id="op_fsvc3" name="createPost" visibility="public"/>
      </packagedElement>
    </packagedElement>

    <!-- ===== SCHEDULE ===== -->
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_sched" name="schedule">
      <packagedElement xmi:type="uml:Class" xmi:id="cls_sched_item" name="ScheduleItem">
        <ownedAttribute xmi:id="a_si1" name="id" visibility="public"/>
        <ownedAttribute xmi:id="a_si2" name="title" visibility="public"/>
        <ownedAttribute xmi:id="a_si3" name="startTime" visibility="public"/>
        <ownedAttribute xmi:id="a_si4" name="endTime" visibility="public"/>
        <ownedAttribute xmi:id="a_si5" name="location" visibility="public"/>
        <ownedAttribute xmi:id="a_si6" name="courseGroupId" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_sched_svc" name="ScheduleService">
        <ownedOperation xmi:id="op_ss1" name="findAll" visibility="public"/>
        <ownedOperation xmi:id="op_ss2" name="getUserSchedule" visibility="public"/>
        <ownedOperation xmi:id="op_ss3" name="create" visibility="public"/>
      </packagedElement>
    </packagedElement>

    <!-- Associations -->
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_user_role">
      <memberEnd xmi:idref="ae_ur_src"/>
      <memberEnd xmi:idref="ae_ur_tgt"/>
      <ownedEnd xmi:id="ae_ur_src" type="cls_user" aggregation="composite" lower="1" upper="1"/>
      <ownedEnd xmi:id="ae_ur_tgt" type="cls_user_role" lower="0" upper="*"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_course_group">
      <memberEnd xmi:idref="ae_cg_src"/>
      <memberEnd xmi:idref="ae_cg_tgt"/>
      <ownedEnd xmi:id="ae_cg_src" type="cls_course" aggregation="composite" lower="1" upper="1"/>
      <ownedEnd xmi:id="ae_cg_tgt" type="cls_course_group" lower="0" upper="*"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_cg_reg">
      <memberEnd xmi:idref="ae_cgr_src"/>
      <memberEnd xmi:idref="ae_cgr_tgt"/>
      <ownedEnd xmi:id="ae_cgr_src" type="cls_course_group" aggregation="composite" lower="1" upper="1"/>
      <ownedEnd xmi:id="ae_cgr_tgt" type="cls_course_reg" lower="0" upper="*"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Association" xmi:id="assoc_cg_assign">
      <memberEnd xmi:idref="ae_cga_src"/>
      <memberEnd xmi:idref="ae_cga_tgt"/>
