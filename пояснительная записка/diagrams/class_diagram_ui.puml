@startuml class_diagram_ui
title Диаграмма классов — Фронтенд (страницы и компоненты)

skinparam classAttributeIconSize 0
skinparam classBorderColor #555
skinparam classBackgroundColor #E8F5E9
skinparam linetype ortho

class AuthPage {
  + «input» Email
  + «input» Пароль
  + «input» Имя пользователя
  + «input» Фамилия
  + «checkbox» Согласие с условиями
  + «captcha» Математическая капча
  + «button» Войти
  + «button» Зарегистрироваться
  + «link» Уже есть аккаунт? Войти
  + «navbar» Header
}

