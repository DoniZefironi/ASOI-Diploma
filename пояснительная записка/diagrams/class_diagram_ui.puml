class AuthStore {
  + user: User | null
  + token: string | null
  + isAuthenticated: boolean
  + login(user, token): void
  + logout(): void
  + hasRole(role): boolean
}

class CircuitStore {
  + nodes: Record<ID, NodeDef>
  + wires: Record<ID, Wire>
  - connectionInProgress: Connection | null
  + addNode(node): ID
  + removeNode(id): void
  + connectWire(wire): void
  + removeWire(id): void
  + runSimulation(): void
  + exportCircuit(): CircuitData
  + importCircuit(data): void
  + clear(): void
}

class ProtectedRoute {
  - requiredRole: string[]
  + checkAuth(): boolean
  + checkRole(): boolean
}

AuthPage --> AuthStore : использует
CoursesPage --> AuthStore : читает токен
AssignmentPage --> AuthStore : читает токен
CircuitPage --> CircuitStore : управляет
ForumPage --> AuthStore : читает токен
AdminUsersPage --> AuthStore : проверяет роль
AdminGroupsPage --> AuthStore : проверяет роль
PeerReviewPage --> AuthStore : читает токен
SchedulePage --> AuthStore : проверяет роль
ProtectedRoute --> AuthStore : canActivate

ForumPage --> ForumSectionPage : навигирует >
ForumSectionPage --> ForumTopicPage : навигирует >
CoursesPage --> CourseDetailPage : навигирует >

@enduml
