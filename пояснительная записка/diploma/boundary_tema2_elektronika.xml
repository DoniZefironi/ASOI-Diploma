      <ownedAttribute xmi:type="uml:Property" xmi:id="a_auth_13" name="«button» Зарегистрироваться" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_auth_14" name="«alert» Сообщение об ошибке (неверные данные / email занят)" visibility="public" isUnique="true" isOrdered="false"/>
    </packagedElement>

    <!-- ═══════════════════════════════════════════════════════ CoursesPage -->
    <packagedElement xmi:type="uml:Class" xmi:id="bnd_CoursesPage" name="CoursesPage" visibility="public">
