<?xml version="1.0" encoding="UTF-8"?>
<!--
  Enterprise Architect — Deployment Diagram
  Тема 2: АСОИ «Интерактивное обучение электронике и английскому языку»
  Импорт: File > Import/Export > Import Package from XMI File
  Затем: Create Diagram > Deployment Diagram
-->
<xmi:XMI xmi:version="2.1"
         xmlns:uml="http://www.omg.org/spec/UML/20090901"
         xmlns:xmi="http://www.omg.org/spec/XMI/20090901">

  <xmi:Documentation exporter="Enterprise Architect" exporterVersion="6.5"/>

  <uml:Model xmi:type="uml:Model" xmi:id="MDL_T2_DEP"
             name="Тема 2 — Диаграмма развёртывания">
    <packagedElement xmi:type="uml:Package" xmi:id="PKG_T2_DEP" name="Deployment_T2">

      <!-- ══════════════════════════════
           «device» Браузер пользователя
      ══════════════════════════════ -->
      <packagedElement xmi:type="uml:Node" xmi:id="N_BROWSER"
                       name=":Браузер пользователя" visibility="public">
        <nestedNode xmi:type="uml:ExecutionEnvironment" xmi:id="N_BROWSER_ENV"
                    name=":Веб-браузер (Chrome / Firefox / Edge)">
          <nestedClassifier xmi:type="uml:Artifact" xmi:id="A_SPA"
                            name=":Next.js SPA (React 19)"/>
          <nestedClassifier xmi:type="uml:Artifact" xmi:id="A_CIRCUIT_CLIENT"
                            name=":CircuitSimulator (SVG + Zustand)"/>
          <nestedClassifier xmi:type="uml:Artifact" xmi:id="A_SWR"
                            name=":SWR (кеширование запросов)"/>
        </nestedNode>
      </packagedElement>

      <!-- ══════════════════════════════
           «device» Сервер приложений
      ══════════════════════════════ -->
      <packagedElement xmi:type="uml:Node" xmi:id="N_SERVER"
                       name=":Сервер приложений" visibility="public">

        <!-- «executionEnvironment» frontend-container -->
        <nestedNode xmi:type="uml:ExecutionEnvironment" xmi:id="N_FE"
                    name=":frontend-container : 3000">
          <nestedClassifier xmi:type="uml:Artifact" xmi:id="A_NEXTJS"
                            name=":Next.js 15 / App Router"/>
          <nestedClassifier xmi:type="uml:Artifact" xmi:id="A_FSD"
                            name=":Feature-Sliced Design"/>
        </nestedNode>

        <!-- «executionEnvironment» backend-container -->
        <nestedNode xmi:type="uml:ExecutionEnvironment" xmi:id="N_BE"
                    name=":backend-container : 2904">
          <nestedClassifier xmi:type="uml:Artifact" xmi:id="A_NESTJS"
                            name=":NestJS REST API"/>
          <nestedClassifier xmi:type="uml:Artifact" xmi:id="A_CIRCUIT_SVC"
                            name=":CircuitService (validateCircuit)"/>
          <nestedClassifier xmi:type="uml:Artifact" xmi:id="A_PEER"
                            name=":PeerReviewService"/>
          <nestedClassifier xmi:type="uml:Artifact" xmi:id="A_HACK"
                            name=":HackathonsService"/>
          <nestedClassifier xmi:type="uml:Artifact" xmi:id="A_MAT"
                            name=":MaterialsService"/>
          <nestedClassifier xmi:type="uml:Artifact" xmi:id="A_VOC"
                            name=":VocabularyService"/>
          <nestedClassifier xmi:type="uml:Artifact" xmi:id="A_AUTH"
                            name=":AuthModule (JWT + Passport)"/>
          <nestedClassifier xmi:type="uml:Artifact" xmi:id="A_TYPEORM"
                            name=":TypeORM"/>
        </nestedNode>

        <!-- «executionEnvironment» postgres-container -->
        <nestedNode xmi:type="uml:ExecutionEnvironment" xmi:id="N_DB"
                    name=":postgres-container : 5432">
          <nestedClassifier xmi:type="uml:Artifact" xmi:id="A_PG"
                            name=":PostgreSQL (19 таблиц)"/>
        </nestedNode>

      </packagedElement>

      <!-- ══════════════════════════════
           СВЯЗИ
      ══════════════════════════════ -->

      <!-- Браузер → Сервер (HTTPS :443) -->
      <packagedElement xmi:type="uml:CommunicationPath" xmi:id="CP_BR_SRV"
                       name="HTTPS :443">
        <memberEnd xmi:idref="CE_BR_1"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="CE_BR_1"
                  type="N_BROWSER" association="CP_BR_SRV"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="CE_BR_2"
                  type="N_FE" association="CP_BR_SRV"/>
      </packagedElement>

      <!-- frontend → backend (HTTP :2904) -->
      <packagedElement xmi:type="uml:CommunicationPath" xmi:id="CP_FE_BE"
                       name="HTTP :2904 (Docker network)">
        <memberEnd xmi:idref="CE_FE_1"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="CE_FE_1"
                  type="N_FE" association="CP_FE_BE"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="CE_FE_2"
                  type="N_BE" association="CP_FE_BE"/>
      </packagedElement>

      <!-- backend → PostgreSQL (TCP :5432) -->
      <packagedElement xmi:type="uml:CommunicationPath" xmi:id="CP_BE_DB"
                       name="TCP :5432 (Docker network)">
        <memberEnd xmi:idref="CE_BE_1"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="CE_BE_1"
                  type="N_BE" association="CP_BE_DB"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="CE_BE_2"
                  type="N_DB" association="CP_BE_DB"/>
      </packagedElement>

    </packagedElement>
  </uml:Model>

  <!-- EA Extension: стереотипы узлов -->
  <xmi:Extension extender="Enterprise Architect" extenderID="6.5">
    <elements>
      <element xmi:idref="N_BROWSER"     xmi:type="uml:Node" name=":Браузер пользователя"    scope="public"><properties stereotype="device"/></element>
      <element xmi:idref="N_BROWSER_ENV" xmi:type="uml:ExecutionEnvironment" name=":Веб-браузер"  scope="public"><properties stereotype="executionEnvironment"/></element>
      <element xmi:idref="N_SERVER"      xmi:type="uml:Node" name=":Сервер приложений"        scope="public"><properties stereotype="device"/></element>
      <element xmi:idref="N_FE"          xmi:type="uml:ExecutionEnvironment" name=":frontend-container : 3000" scope="public"><properties stereotype="executionEnvironment"/></element>
      <element xmi:idref="N_BE"          xmi:type="uml:ExecutionEnvironment" name=":backend-container : 2904"  scope="public"><properties stereotype="executionEnvironment"/></element>
      <element xmi:idref="N_DB"          xmi:type="uml:ExecutionEnvironment" name=":postgres-container : 5432" scope="public"><properties stereotype="executionEnvironment"/></element>
    </elements>
  </xmi:Extension>

</xmi:XMI>
