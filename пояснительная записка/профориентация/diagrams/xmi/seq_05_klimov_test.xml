<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1"
         xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML">
  <uml:Model xmi:id="model_seq05" name="Прохождение теста Климова">
    <packagedElement xmi:type="uml:Interaction" xmi:id="ia_klimov" name="Прохождение теста Климова (ДДО)">

      <lifeline xmi:id="ll_user" name="Студент"                   represents="ll_user"/>
      <lifeline xmi:id="ll_c"    name="Браузер (Next.js)"          represents="ll_c"/>
      <lifeline xmi:id="ll_pc"   name="ProfOrientationController"  represents="ll_pc"/>
      <lifeline xmi:id="ll_ps"   name="ProfOrientationService"     represents="ll_ps"/>
      <lifeline xmi:id="ll_ie"   name="InferenceEngineService"     represents="ll_ie"/>
      <lifeline xmi:id="ll_db"   name="PostgreSQL"                 represents="ll_db"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m1s" covered="ll_user"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m1r" covered="ll_c"/>
      <message xmi:id="msg1" name="Открыть /tests/klimov" sendEvent="m1s" receiveEvent="m1r" messageSort="synchCall"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m2s" covered="ll_c"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m2r" covered="ll_pc"/>
      <message xmi:id="msg2" name="GET /professional-orientation/tests/klimov/questions" sendEvent="m2s" receiveEvent="m2r" messageSort="synchCall"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m3s" covered="ll_pc"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m3r" covered="ll_db"/>
      <message xmi:id="msg3" name="SELECT career_tests WHERE type=klimov AND isActive=true" sendEvent="m3s" receiveEvent="m3r" messageSort="synchCall"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m4s" covered="ll_db"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m4r" covered="ll_c"/>
      <message xmi:id="msg4" name="TestConfig {20 вопросов, choice}" sendEvent="m4s" receiveEvent="m4r" messageSort="reply"/>

      <fragment xmi:type="uml:CombinedFragment" xmi:id="cf_loop" interactionOperator="loop">
        <operand xmi:id="op_loop">
          <guard xmi:id="g_loop"><specification value="20 вопросов"/></guard>
          <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m5s" covered="ll_user"/>
          <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m5r" covered="ll_c"/>
          <message xmi:id="msg5" name="Выбрать А или Б" sendEvent="m5s" receiveEvent="m5r" messageSort="synchCall"/>
        </operand>
      </fragment>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m6s" covered="ll_c"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m6r" covered="ll_pc"/>
      <message xmi:id="msg6" name="POST /professional-orientation/tests/submit {testType:klimov, answers:[]}" sendEvent="m6s" receiveEvent="m6r" messageSort="synchCall"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m7s" covered="ll_pc"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m7r" covered="ll_ps"/>
      <message xmi:id="msg7" name="submitTest(userId, dto)" sendEvent="m7s" receiveEvent="m7r" messageSort="synchCall"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m8s" covered="ll_ps"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m8r" covered="ll_db"/>
      <message xmi:id="msg8" name="SELECT professional_orientations WHERE userId=? (RIASEC)" sendEvent="m8s" receiveEvent="m8r" messageSort="synchCall"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m9s" covered="ll_ps"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m9r" covered="ll_ie"/>
      <message xmi:id="msg9" name="runInference(traitsVector)" sendEvent="m9s" receiveEvent="m9r" messageSort="synchCall"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m10s" covered="ll_ie"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m10r" covered="ll_ps"/>
      <message xmi:id="msg10" name="{topProfessions, personalityProfile}" sendEvent="m10s" receiveEvent="m10r" messageSort="reply"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m11s" covered="ll_ps"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m11r" covered="ll_db"/>
      <message xmi:id="msg11" name="UPDATE professional_orientations {testResult, recommendedProfession}" sendEvent="m11s" receiveEvent="m11r" messageSort="synchCall"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m12s" covered="ll_pc"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m12r" covered="ll_c"/>
      <message xmi:id="msg12" name="200 OK {FullOrientationResult}" sendEvent="m12s" receiveEvent="m12r" messageSort="reply"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m13s" covered="ll_c"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m13r" covered="ll_user"/>
      <message xmi:id="msg13" name="Редирект на /results" sendEvent="m13s" receiveEvent="m13r" messageSort="reply"/>
    </packagedElement>
  </uml:Model>
</xmi:XMI>
