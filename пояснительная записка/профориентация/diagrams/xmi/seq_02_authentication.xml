<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1"
         xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML">
  <uml:Model xmi:id="model_seq02" name="Проверка аутентификации">
    <packagedElement xmi:type="uml:Interaction" xmi:id="ia_authn" name="Проверка аутентификации">

      <lifeline xmi:id="ll_user"   name="Пользователь"    represents="ll_user"/>
      <lifeline xmi:id="ll_pr"     name="ProtectedRoute"  represents="ll_pr"/>
      <lifeline xmi:id="ll_ac"     name="AuthController"  represents="ll_ac"/>
      <lifeline xmi:id="ll_jg"     name="JwtAuthGuard"    represents="ll_jg"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m1s" covered="ll_user"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m1r" covered="ll_pr"/>
      <message xmi:id="msg1" name="Переход на защищённую страницу" sendEvent="m1s" receiveEvent="m1r" messageSort="synchCall"/>

      <fragment xmi:type="uml:CombinedFragment" xmi:id="cf_token" interactionOperator="alt">
        <operand xmi:id="op_no_token">
          <guard xmi:id="g_no_token"><specification value="Токен отсутствует"/></guard>
          <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m2s" covered="ll_pr"/>
          <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m2r" covered="ll_user"/>
          <message xmi:id="msg2" name="Редирект на /auth" sendEvent="m2s" receiveEvent="m2r" messageSort="reply"/>
        </operand>
        <operand xmi:id="op_has_token">
          <guard xmi:id="g_has_token"><specification value="Токен найден"/></guard>
          <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m3s" covered="ll_pr"/>
          <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m3r" covered="ll_ac"/>
          <message xmi:id="msg3" name="GET /auth/debug Bearer token" sendEvent="m3s" receiveEvent="m3r" messageSort="synchCall"/>

          <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m4s" covered="ll_ac"/>
          <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m4r" covered="ll_jg"/>
          <message xmi:id="msg4" name="verify(token)" sendEvent="m4s" receiveEvent="m4r" messageSort="synchCall"/>

          <fragment xmi:type="uml:CombinedFragment" xmi:id="cf_jwt" interactionOperator="alt">
            <operand xmi:id="op_expired">
              <guard xmi:id="g_expired"><specification value="Токен невалиден / истёк"/></guard>
              <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m5s" covered="ll_pr"/>
              <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m5r" covered="ll_user"/>
              <message xmi:id="msg5" name="Редирект на /auth" sendEvent="m5s" receiveEvent="m5r" messageSort="reply"/>
            </operand>
            <operand xmi:id="op_valid">
              <guard xmi:id="g_valid"><specification value="Токен валиден"/></guard>
              <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m6s" covered="ll_pr"/>
              <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m6r" covered="ll_user"/>
              <message xmi:id="msg6" name="Отобразить страницу" sendEvent="m6s" receiveEvent="m6r" messageSort="reply"/>
            </operand>
          </fragment>
        </operand>
      </fragment>
    </packagedElement>
  </uml:Model>
</xmi:XMI>
