<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1"
         xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML">
  <uml:Model xmi:id="model_seq07" name="Просмотр результатов анализа">
    <packagedElement xmi:type="uml:Interaction" xmi:id="ia_results" name="Просмотр результатов анализа">

      <lifeline xmi:id="ll_user" name="Студент"                   represents="ll_user"/>
      <lifeline xmi:id="ll_c"    name="Браузер (Next.js)"          represents="ll_c"/>
      <lifeline xmi:id="ll_pc"   name="ProfOrientationController"  represents="ll_pc"/>
      <lifeline xmi:id="ll_ps"   name="ProfOrientationService"     represents="ll_ps"/>
      <lifeline xmi:id="ll_ie"   name="InferenceEngineService"     represents="ll_ie"/>
      <lifeline xmi:id="ll_db"   name="PostgreSQL"                 represents="ll_db"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m1s" covered="ll_user"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m1r" covered="ll_c"/>
      <message xmi:id="msg1" name="Открыть /results" sendEvent="m1s" receiveEvent="m1r" messageSort="synchCall"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m2s" covered="ll_c"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m2r" covered="ll_pc"/>
      <message xmi:id="msg2" name="GET /professional-orientation/results" sendEvent="m2s" receiveEvent="m2r" messageSort="synchCall"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m3s" covered="ll_pc"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m3r" covered="ll_ps"/>
      <message xmi:id="msg3" name="getResults(userId)" sendEvent="m3s" receiveEvent="m3r" messageSort="synchCall"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m4s" covered="ll_ps"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m4r" covered="ll_db"/>
      <message xmi:id="msg4" name="SELECT professional_orientations WHERE userId=? ORDER BY createdAt DESC LIMIT 1" sendEvent="m4s" receiveEvent="m4r" messageSort="synchCall"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m5s" covered="ll_db"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m5r" covered="ll_ps"/>
      <message xmi:id="msg5" name="latestOrientation | null" sendEvent="m5s" receiveEvent="m5r" messageSort="reply"/>

      <fragment xmi:type="uml:CombinedFragment" xmi:id="cf_alt" interactionOperator="alt">
        <operand xmi:id="op_no">
          <guard xmi:id="g_no"><specification value="Тесты не пройдены"/></guard>
          <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m6s" covered="ll_pc"/>
          <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m6r" covered="ll_c"/>
          <message xmi:id="msg6" name="404 Not Found" sendEvent="m6s" receiveEvent="m6r" messageSort="reply"/>
        </operand>
        <operand xmi:id="op_yes">
          <guard xmi:id="g_yes"><specification value="Результаты найдены"/></guard>
          <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m7s" covered="ll_ps"/>
          <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m7r" covered="ll_ie"/>
          <message xmi:id="msg7" name="runInference(orientation.traits)" sendEvent="m7s" receiveEvent="m7r" messageSort="synchCall"/>

          <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m8s" covered="ll_ie"/>
          <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m8r" covered="ll_ps"/>
          <message xmi:id="msg8" name="InferenceResult {topProfessions, profile, strengths, weaknesses}" sendEvent="m8s" receiveEvent="m8r" messageSort="reply"/>

          <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m9s" covered="ll_pc"/>
          <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m9r" covered="ll_c"/>
          <message xmi:id="msg9" name="200 OK {ResultsDto}" sendEvent="m9s" receiveEvent="m9r" messageSort="reply"/>

          <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m10s" covered="ll_c"/>
          <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m10r" covered="ll_user"/>
          <message xmi:id="msg10" name="Отобразить: радарная диаграмма, топ-5, архетип, сильные/слабые стороны" sendEvent="m10s" receiveEvent="m10r" messageSort="reply"/>
        </operand>
      </fragment>
    </packagedElement>
  </uml:Model>
</xmi:XMI>
