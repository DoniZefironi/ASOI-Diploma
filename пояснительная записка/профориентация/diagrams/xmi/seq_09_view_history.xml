<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1"
         xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML">
  <uml:Model xmi:id="model_seq09" name="Просмотр истории тестирований">
    <packagedElement xmi:type="uml:Interaction" xmi:id="ia_history" name="Просмотр истории тестирований">

      <lifeline xmi:id="ll_user" name="Студент"                   represents="ll_user"/>
      <lifeline xmi:id="ll_c"    name="Браузер (Next.js)"          represents="ll_c"/>
      <lifeline xmi:id="ll_pc"   name="ProfOrientationController"  represents="ll_pc"/>
      <lifeline xmi:id="ll_ps"   name="ProfOrientationService"     represents="ll_ps"/>
      <lifeline xmi:id="ll_db"   name="PostgreSQL"                 represents="ll_db"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m1s" covered="ll_user"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m1r" covered="ll_c"/>
      <message xmi:id="msg1" name="Открыть /history" sendEvent="m1s" receiveEvent="m1r" messageSort="synchCall"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m2s" covered="ll_c"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m2r" covered="ll_pc"/>
      <message xmi:id="msg2" name="GET /professional-orientation/history" sendEvent="m2s" receiveEvent="m2r" messageSort="synchCall"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m3s" covered="ll_pc"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m3r" covered="ll_ps"/>
      <message xmi:id="msg3" name="getHistory(userId)" sendEvent="m3s" receiveEvent="m3r" messageSort="synchCall"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m4s" covered="ll_ps"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m4r" covered="ll_db"/>
      <message xmi:id="msg4" name="SELECT professional_orientations WHERE userId=? ORDER BY createdAt DESC" sendEvent="m4s" receiveEvent="m4r" messageSort="synchCall"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m5s" covered="ll_ps"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m5r" covered="ll_db"/>
      <message xmi:id="msg5" name="SELECT learning_roadmaps WHERE userId=?" sendEvent="m5s" receiveEvent="m5r" messageSort="synchCall"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m6s" covered="ll_pc"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m6r" covered="ll_c"/>
      <message xmi:id="msg6" name="200 OK {HistoryDto[]}" sendEvent="m6s" receiveEvent="m6r" messageSort="reply"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m7s" covered="ll_c"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m7r" covered="ll_user"/>
      <message xmi:id="msg7" name="Отобразить список тестирований" sendEvent="m7s" receiveEvent="m7r" messageSort="reply"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m8s" covered="ll_user"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m8r" covered="ll_c"/>
      <message xmi:id="msg8" name="Выбрать конкретное тестирование" sendEvent="m8s" receiveEvent="m8r" messageSort="synchCall"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m9s" covered="ll_c"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m9r" covered="ll_pc"/>
      <message xmi:id="msg9" name="GET /professional-orientation/history/:id" sendEvent="m9s" receiveEvent="m9r" messageSort="synchCall"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m10s" covered="ll_ps"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m10r" covered="ll_db"/>
      <message xmi:id="msg10" name="SELECT orientation + roadmap WHERE id=:id AND userId=?" sendEvent="m10s" receiveEvent="m10r" messageSort="synchCall"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m11s" covered="ll_pc"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m11r" covered="ll_c"/>
      <message xmi:id="msg11" name="200 OK {HistoryItemDto {orientation, roadmap}}" sendEvent="m11s" receiveEvent="m11r" messageSort="reply"/>

      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m12s" covered="ll_c"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="m12r" covered="ll_user"/>
      <message xmi:id="msg12" name="Отобразить детали тестирования" sendEvent="m12s" receiveEvent="m12r" messageSort="reply"/>
    </packagedElement>
  </uml:Model>
</xmi:XMI>
